---
import BaseLayout from '../layouts/BaseLayout.astro';

// Accès direct au binding D1 : un Worker ne peut pas s'appeler lui-même en HTTP
// (cela provoquerait une boucle de sous-requête sur sa propre zone).
const env = Astro.locals.runtime?.env;

let d1 = 'indisponible';
try {
  const row = await env?.DB.prepare('SELECT 1 AS ok').first<{ ok: number }>();
  d1 = row?.ok === 1 ? 'ok' : 'reponse-inattendue';
} catch (error) {
  d1 = `erreur: ${(error as Error).message}`;
}
---

<BaseLayout>
  <h1 class="text-xl font-bold text-slate-800">Gestionnaire de scripts NumWorks</h1>

  <p class="mt-4 text-slate-600">
    Le socle technique est en place. Les fonctionnalités seront ajoutées au fur et à mesure de la
    spécification du projet.
  </p>

  <section class="mt-8 border border-slate-200 bg-white p-4">
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500">Diagnostic</h2>
    <ul class="mt-3 space-y-1 font-mono text-xs">
      <li>Worker : <span class="text-emerald-700">ok</span></li>
      <li>
        Base D1 (binding <code>DB</code>) :
        <span class:list={[d1 === 'ok' ? 'text-emerald-700' : 'text-red-700']}>{d1}</span>
      </li>
    </ul>
    <p class="mt-3 text-2xs text-slate-500">
      Sonde machine : <a class="text-[#9A29D2] underline" href="/api/health">/api/health</a>
    </p>
  </section>
</BaseLayout>
