---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'numaps.nsi.xyz' } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Gestionnaire de scripts pour calculatrice NumWorks." />
  </head>
  <body class="min-h-screen">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center gap-3 px-4 py-3">
        <a href="/" class="flex items-center gap-2 font-bold text-slate-800">
          <span class="text-[#9A29D2]">&#9679;</span>
          <span>numaps.nsi.xyz</span>
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>

    <footer class="mx-auto max-w-5xl px-4 py-8 text-2xs text-slate-500">
      <p>numaps.nsi.xyz — gestionnaire de scripts NumWorks</p>
    </footer>
  </body>
</html>
