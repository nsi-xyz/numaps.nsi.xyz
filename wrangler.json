  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "numaps-nsi-xyz",
      "database_id": "f8ca591f-abc5-4881-a077-e5156e22e5a3"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "9dcddad8ffdf4946a2df577dd3dba54e"
    }
  ],
  "observability": {
    "enabled": true
  }
}
